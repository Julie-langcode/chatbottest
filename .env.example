# Server-side only: read by api/chat.ts on Vercel and by the Vite dev server locally.
# Never prefix it with VITE_ — that would put the key into the browser bundle.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the model used for both the coach and the checker.
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
