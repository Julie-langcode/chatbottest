# Server-side only: read by api/chat.ts on Vercel and by the Vite dev server locally.
# Never prefix these with VITE_ — that would put the keys into the browser bundle.

# --- Yandex AI Studio (default provider) ---
YANDEX_API_KEY=your_yandex_api_key_secret
YANDEX_FOLDER_ID=your_folder_id
# Optional: model and endpoint
# YANDEX_MODEL=aliceai-llm            # or yandexgpt-5.1, yandexgpt-5-pro
# YANDEX_API_URL=https://ai.api.cloud.yandex.net/foundationModels/v1/completion

# --- Anthropic (optional alternative) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# If both providers are configured: yandex | anthropic
# MODEL_PROVIDER=yandex
